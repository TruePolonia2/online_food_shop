# ==============================================================================
# Online Food Shop - Local Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root directory and customize your values.
# The '.env' file is ignored by Git and must never contain committed secrets.
# ==============================================================================

# Application Environment Profile
# Supported values: development, testing, production
FLASK_CONFIG=development

# Flask Debug Mode (True for interactive debugger and auto-reloader in development)
FLASK_DEBUG=True

# Flask Secret Key
# In development, a fallback default is provided. In production, this MUST be set
# to a strong, cryptographically secure random value (e.g. python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=dev-secret-key-change-in-production

# SQLite Database Location (optional override, defaults to instance/online_food_shop.sqlite3)
# DATABASE_PATH=instance/online_food_shop.sqlite3

# Google OAuth 2.0 / OpenID Connect (Optional in development)
# When configured, Google Sign-In and Registration become active on /login and /register.
# Obtain these credentials from the Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Delivery Configuration (Phase 10.11)
# EMAIL_BACKEND: 'memory' (simulated in-memory delivery) or 'smtp' (live SMTP delivery)
EMAIL_BACKEND=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_TIMEOUT=10
APP_BASE_URL=http://127.0.0.1:5000

# Stripe Payment Integration (Phase 10.12 & Phase 10.13 - TEST MODE ONLY)
# Only test mode keys (sk_test_*, pk_test_*, whsec_*) are permitted.
# Live keys (sk_live_*, pk_live_*, whsec_live_*) are explicitly rejected at startup.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_CURRENCY=eur

# Stripe Webhook Secret (Phase 10.13 - Authoritative Payment Confirmation)
# For local testing, use the Stripe CLI to forward real test webhook events:
#   1. Install Stripe CLI: https://stripe.com/docs/stripe-cli
#   2. Authenticate: stripe login
#   3. Forward webhooks to local server:
#        stripe listen --forward-to localhost:5000/webhooks/stripe
#   4. Copy the webhook signing secret (whsec_...) printed by the CLI into your .env:
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
#
# IMPORTANT MANUAL TEST PROCEDURE (Real Checkout Session):
# Note: Generic 'stripe trigger checkout.session.completed' fixtures use dummy IDs
# that will NOT match any real order in your local database. To test end-to-end:
#   a. Start your local Flask server (e.g. python run.py).
#   b. Run 'stripe listen --forward-to localhost:5000/webhooks/stripe' in another terminal.
#   c. Open http://127.0.0.1:5000 in your browser, add items, and checkout with Stripe.
#   d. Complete test payment on Stripe's hosted checkout using test card 4242...
#   e. Watch 'stripe listen' forward the real 'checkout.session.completed' event.
#   f. Verify your store order transitions from 'Pending' to 'Confirmed' / 'Paid'.

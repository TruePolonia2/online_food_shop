# ==============================================================================
# Online Food Shop - Local Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root directory and customize your values.
# The '.env' file is ignored by Git and must never contain committed secrets.
# ==============================================================================

# Application Environment Profile
# Supported values: development, testing, production
FLASK_CONFIG=development

# Flask Debug Mode (True for interactive debugger and auto-reloader in development)
FLASK_DEBUG=True

# Flask Secret Key
# In development, a fallback default is provided. In production, this MUST be set
# to a strong, cryptographically secure random value (e.g. python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=dev-secret-key-change-in-production

# SQLite Database Location (optional override, defaults to instance/online_food_shop.sqlite3)
# DATABASE_PATH=instance/online_food_shop.sqlite3

# Google OAuth 2.0 / OpenID Connect (Optional in development)
# When configured, Google Sign-In and Registration become active on /login and /register.
# Obtain these credentials from the Google Cloud Console (APIs & Services > Credentials).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
